#!/bin/sh

# avro-tools is a shaded jar bundling its own Hadoop, so keep it off the parquet classpath
CLASSPATH="/opt/parquet-mr-tools/avro/*"

# JAVA_OPTS is intentionally unquoted so multiple options are split into separate arguments
exec java $JAVA_OPTS -cp "$CLASSPATH" org.apache.avro.tool.Main "$@"
